# Build output — wiped and regenerated by `python3 site/build.py` on every run.
# Remove this line if you deploy to GitHub Pages from the repo itself.
site/dist/

# Secrets. serve.py reads these at startup (STRIPE_SECRET_KEY, OPS_PASSWORD,
# UPSTASH_*). A committed .env is a leaked key — keep this rule.
.env
.env.*
!.env.example
site/.env

# Local analytics store — real visitor behaviour in dev, seeded noise otherwise.
# Never committed; production writes to Upstash instead (see DEPLOY.md).
site/analytics.ndjson
analytics.ndjson

# Local sign-up store (the header auth panel). Real emails in dev — PII, never
# committed. Production writes to Upstash, same as analytics (see accounts.py).
site/accounts.ndjson
accounts.ndjson

# Local fulfilment log (Stripe webhook → orders). Order/customer data, never
# committed. Production fulfilment writes elsewhere (see payments.py).
site/orders.log
orders.log

# Local orders store (the /ops Orders tab). Holds order + customer data (PII),
# seeded rows carry `syn`; production writes to Upstash, same as accounts (see
# src/orders.py). Never committed.
site/orders.ndjson
orders.ndjson

# Local roster store (the boosters board). Seeded/synthetic in dev — the rows
# carry `syn` — and production writes to Upstash, same as analytics and
# accounts (see src/boosters.py). Never committed.
site/boosters.ndjson
boosters.ndjson

# Local guides-mail store (the free-guides landing's mailing list). Holds real
# emails; production writes to Upstash, same as accounts (see src/guides.py).
# Never committed.
site/guides.ndjson
guides.ndjson

# Local abandoned-cart store (src/carts.py). Holds a captured email NEXT TO the
# order it was about to buy, plus the single-use recovery token that resolves to
# a real discount server-side — so it is the most sensitive of these five, not
# the least. Production writes to Upstash. Never committed.
site/carts.ndjson
carts.ndjson

# Vercel CLI project link (project/org ids). Local-only, never committed.
.vercel

# Python
__pycache__/
*.py[cod]

# macOS
.DS_Store

# Design-handoff prototype runtime state (image-slot.js drop-in placeholders)
.image-slots.state.json

# Logo sources downloaded from the live site by tools/export_ad_logos.py.
# Re-fetched on demand; the exported ad assets in site/assets-out/ are kept.
site/tools/.assetcache/
