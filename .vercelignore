# Reference-only design handoffs — never imported at build time (see CLAUDE.md)
redesign_zip/
redesign_zip_v2/

# Build output — Vercel regenerates it via buildCommand
site/dist/

# Local fulfilment log, never committed
site/orders.log
orders.log

# Secrets live in Vercel's own env-var settings, never in the upload
.env
.env.*
site/.env

# Local analytics store — production writes to Upstash, never to a file
site/analytics.ndjson
analytics.ndjson

# Developer scripts, not part of the build or the runtime
site/tools/

# Docs not needed at runtime
CRO-AUDIT.md
CRO-AUDIT.fr.md

# Python / macOS cruft
__pycache__/
*.py[cod]
.DS_Store
